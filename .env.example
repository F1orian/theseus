# Copy to .env (gitignored) and fill in. Used by the opt-in integration tests and fixture recording.
# Use a test account on a server you run, never an admin account you care about.
THESEUS_OWUI_URL=
THESEUS_OWUI_EMAIL=
THESEUS_OWUI_PASSWORD=
# Optional: API key (sk-...) from Settings > Account, for testing the stateless/SSE path
THESEUS_OWUI_API_KEY=
